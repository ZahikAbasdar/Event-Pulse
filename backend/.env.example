# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/eventpulse

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change_this_too

# Initial administrator (required by `npm run seed`)
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# Email (for certificates, notifications) - optional, app degrades gracefully without it
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EventPulse <no-reply@eventpulse.local>"

# File uploads
MAX_UPLOAD_MB=15
MEDIA_UPLOAD_DIR=./uploads

# Durable object storage for production uploads and voice feedback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=eventpulse-media
SUPABASE_VOICE_BUCKET=eventpulse-voice

# AI Assistant (EventPulse AI) - bring your own key, backend only, never exposed to frontend
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# YouTube Data API v3 (server-side only; used to list PCTE channel uploads)
YOUTUBE_API_KEY=

# Twilio Verify SMS OTP
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Voice feedback: local directory; production deployments need a persistent, backed-up volume.
VOICE_FEEDBACK_DIR=./private/feedback-audio
MAX_VOICE_FEEDBACK_MB=25
